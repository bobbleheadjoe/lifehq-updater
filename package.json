{
  "name": "lifehq-updater",
  "version": "0.1.1",
  "description": "Update a LifeHQ vault to a new release without overwriting your customizations.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node test/merge.test.mjs"
  },
  "author": "Mike Schmitz",
  "license": "UNLICENSED",
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.20.2",
    "obsidian": "1.8.7",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}
